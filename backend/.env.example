# Google Drive — the ID of your root IB Papers folder
# (copy the bold part from: drive.google.com/drive/folders/THIS_PART)
DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ── Drive authentication — choose ONE of the two methods below ───────────────

# METHOD A — OAuth refresh token (use this if service account keys are blocked)
# Run  python get_refresh_token.py  once to generate these three values.
GOOGLE_REFRESH_TOKEN=1//0g...
GOOGLE_CLIENT_SECRET=GOCSPX-...
# (GOOGLE_CLIENT_ID is shared with student login — set it once below)

# METHOD B — Service account JSON key (only if your org allows key creation)
# Paste the entire JSON file contents as a single line. Leave blank for Method A.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# From Google Cloud Console → OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# A random secret for signing JWT session tokens (run: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_random_secret_string

# The URL of your frontend (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Comma-separated email addresses or domains that are allowed to log in.
# Leave blank to allow anyone with a Google account.
ALLOWED_EMAIL_DOMAINS=yourstudents.com,gmail.com

# Your own email — used to access the /api/admin/refresh-index endpoint
ADMIN_EMAIL=you@example.com

# Set to "production" when deploying
ENV=development
