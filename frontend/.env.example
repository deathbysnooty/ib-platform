# The URL of your backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# From Google Cloud Console → OAuth 2.0 Client ID (Web application type)
# Must match GOOGLE_CLIENT_ID in the backend .env
VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Your admin Google account email — shows the Admin button only to you
VITE_ADMIN_EMAIL=you@gmail.com
